# Configuration de votre instance House OS — copier vers .env à côté de docker-compose.yml.
# Le .env n'est JAMAIS committé (.gitignore). Générer les clés : openssl rand -hex 32
#
# Les variables « requises » font refuser le démarrage au compose (message explicite)
# plutôt que de retomber sur une valeur du dépôt.
#
# En dev, le compose ne sert qu'à Postgres (`docker compose up -d postgres`) : prendre
# plutôt `cp infra/exemples/.env.dev .env` (valeurs jetables alignées sur
# server/HouseOs.Api/appsettings.Development.json).

# ============================ Requis ============================

# Mot de passe de la base PostgreSQL (utilisateur houseos)
POSTGRES_PASSWORD=

# Position de la maison (météo Open-Meteo, sans clé). Ex. Québec : 46.81 / -71.21
METEO_LATITUDE=
METEO_LONGITUDE=

# Comptes du foyer — créés seulement à la première mise en route (base vierge).
# Nom d'utilisateur en minuscules, sans espace ; le nom d'affichage est facultatif
# (défaut : le nom d'utilisateur). Le second compte est facultatif.
COMPTE_1_NOM=
COMPTE_1_AFFICHAGE=
COMPTE_1_MDP=
COMPTE_2_NOM=
COMPTE_2_AFFICHAGE=
COMPTE_2_MDP=
# Adresses de courriel, facultatives : c'est là que la lettre du matin arrive
#COMPTE_1_COURRIEL=
#COMPTE_2_COURRIEL=

# Clé API du endpoint /mcp (Claude Code) — openssl rand -hex 32
HOUSEOS_MCP_KEY=

# ========================== Facultatif ==========================

# Lieu de publication imprimé dans le bloc-titre de l'écran mural, comme le nom de
# ville d'un quotidien — « 12 rue des Lilas », « Rue Fraser, Québec ». Vide : l'écran
# n'imprime rien à cette place.
#MAISON_LIEU=

# Clé de la poussée de calendriers externes — openssl rand -hex 32. Elle autorise un
# programme extérieur (un gratteur de site municipal, par exemple) à remplacer les
# événements d'un calendrier « poussé », et rien d'autre : c'est pour ça qu'elle n'est
# pas celle du MCP. Vide : la poussée refuse tout.
#HOUSEOS_POUSSEE_CLE=

# Banque du hasard (dictons de l'almanach, fêtes du jour) : chemin, dans le conteneur,
# d'un fichier qui remplace la banque québécoise livrée avec l'app. Voir
# docs/configuration.md. Vide : la banque livrée sert.
#HASARD_FICHIER=

# Fuseau horaire (conteneur + météo). Défaut : America/Toronto
#FUSEAU_HORAIRE=America/Toronto

# Ports publiés sur l'hôte. Défauts : 8080 (app) et 5433 (postgres, 127.0.0.1 seulement)
#APP_PORT_HOTE=8080
#POSTGRES_PORT_HOTE=5433

# Reverse proxy HTTPS devant l'app : IPs ou CIDR (séparés par des virgules) autorisés
# à poser X-Forwarded-*. Requis pour que le cookie de session soit marqué Secure
# derrière un proxy. Si le cookie ne se pose pas au login HTTPS, Docker réécrit
# probablement l'IP source : ajouter le sous-réseau du compose (ex. 172.18.0.0/16).
#RESEAU_PROXIES_CONNUS=192.168.1.10

# Clé Anthropic pour le titre d'humeur et l'enrichissement des courriels
# (sans elle : banque de phrases et classement déterministe)
#ANTHROPIC_API_KEY=

# --- Journalisation structurée (Seq) ---
# Sans URL, l'app journalise en console seulement (docker logs houseos-app).
#JOURNALISATION_SEQ_URL=http://seq.local:5341
#JOURNALISATION_SEQ_CLE=

# --- Flux iCal public (Tailscale Funnel) ---
# Active le sidecar tailscale du compose (absent = pas d'exposition publique)
#COMPOSE_PROFILES=funnel
# Auth key taguée (admin console Tailscale → Settings → Keys) ; la policy du
# tailnet doit accorder l'attribut « funnel » à ce tag
#TS_AUTHKEY=
# Base de l'URL publique affichée dans « Mon calendrier »
#ICAL_URL_PUBLIQUE_BASE=https://houseos.<tailnet>.ts.net

# --- Documents par courriel (Cloudflare Email Routing → Worker → R2) ---
# Voir infra/courriel-worker/README.md. Sans ces quatre valeurs, le relevé est
# désactivé. Endpoint S3 du compte : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#COURRIEL_R2_ENDPOINT=
#COURRIEL_R2_BUCKET=houseos-courriel
# Jeton R2 « Object Read & Write » scopé au bucket (R2 → Manage API Tokens)
#COURRIEL_R2_CLE_ACCES=
#COURRIEL_R2_CLE_SECRETE=

# --- La lettre du matin (courriel sortant, facultatif) ---
# Un courriel par jour, écrit par la maison, à chaque compte qui a une adresse
# (COMPTE_1_COURRIEL, COMPTE_2_COURRIEL ci-dessus). Sans hôte ni expéditeur, la
# lettre se compose et se lit dans l'app mais ne part pas.
# Gmail : smtp.gmail.com, 587, l'adresse et un mot de passe d'application.
#LETTRE_SMTP_HOTE=
#LETTRE_SMTP_PORT=587
#LETTRE_SMTP_USAGER=
#LETTRE_SMTP_MDP=
# « La maison <maison@exemple.tld> » ou une adresse nue
#LETTRE_SMTP_EXPEDITEUR=
# Heure d'envoi (défaut 06:30) ; rattrapée le jour même jusqu'à midi
#LETTRE_HEURE=06:30
# Base de l'URL de l'app pour le lien « Ouvrir la journée » (vide = pas de lien)
#LETTRE_URL_APP=https://houseos.exemple.tld

# --- Écran e-ink mural (facultatif : les défauts conviennent) ---
# Cadence de réveil le jour, en secondes (défaut 900 = 15 min). C'est le réveil
# Wi-Fi qui vide la pile, pas le rafraîchissement du panneau : 300 s a coûté
# 0,25 V en 16 jours sur un reTerminal E1003.
#ECRAN_CADENCE_SECONDES=900
# Plus long sommeil demandé au firmware (défaut 3600). Il plafonne aussi la nuit,
# qui se découpe donc en sommeils d'une heure. Au-delà de 3600 s, vérifier que le
# firmware l'honore avant de s'y fier.
#ECRAN_PLAFOND_SECONDES=3600
