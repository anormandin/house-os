# Secrets du serveur House OS — copier vers .env à côté de docker-compose.yml.
# Le .env n'est JAMAIS committé (.gitignore). Générer les clés : openssl rand -hex 32

# Mot de passe de la base PostgreSQL (utilisateur houseos)
POSTGRES_PASSWORD=

# Clé API du endpoint /mcp (Claude Code) — openssl rand -hex 32
HOUSEOS_MCP_KEY=

# Clé Anthropic pour le titre d'humeur (facultatif : sans elle, repli sur la
# banque de phrases)
ANTHROPIC_API_KEY=

# Mots de passe initiaux des comptes alain / ariane — appliqués seulement à la
# création des utilisateurs (base vierge)
SEED_MDP_ALAIN=
SEED_MDP_ARIANE=
