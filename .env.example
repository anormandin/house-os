# Secrets du serveur House OS — copier vers .env à côté de docker-compose.yml.
# Le .env n'est JAMAIS committé (.gitignore). Générer les clés : openssl rand -hex 32
#
# POSTGRES_PASSWORD, HOUSEOS_MCP_KEY, SEED_MDP_* sont REQUIS : le compose refuse de
# démarrer (erreur explicite) plutôt que de retomber sur une valeur du repo.
# En dev (où le compose ne sert que postgres), un .env local avec les valeurs dev
# suffit : POSTGRES_PASSWORD=houseos-dev, HOUSEOS_MCP_KEY=dev-cle-mcp-houseos,
# SEED_MDP_*=45234523 (le seed dev vit dans appsettings.Development.json).

# Mot de passe de la base PostgreSQL (utilisateur houseos) — requis
POSTGRES_PASSWORD=

# Clé API du endpoint /mcp (Claude Code) — requis — openssl rand -hex 32
HOUSEOS_MCP_KEY=

# Clé Anthropic pour le titre d'humeur (facultatif : sans elle, repli sur la
# banque de phrases)
ANTHROPIC_API_KEY=

# Mots de passe initiaux des comptes alain / ariane — requis — appliqués seulement
# à la création des utilisateurs (base vierge)
SEED_MDP_ALAIN=
SEED_MDP_ARIANE=

# --- Journalisation structurée (Seq) ---
# Le collecteur n'est PAS dans ce compose : il vit dans son propre LXC (106,
# « observabilite », dépôt /opt/observabilite) et sert toutes les apps du lab.
# Ici on ne configure que l'expédition.
#
# Clé d'ingestion « house-os » — requise — créée dans Seq
# (Settings → API Keys, permission Ingest). L'ingestion anonyme est fermée.
JOURNALISATION_SEQ_CLE=
# Adresse du collecteur (défaut : le LXC 106 sur le LAN)
#JOURNALISATION_SEQ_URL=http://192.168.4.36:5341

# Proxys autorisés à poser X-Forwarded-* (IPs ou CIDR, séparés par des virgules).
# Défaut : 192.168.4.50 (le NPM du LAN). Si le cookie Secure ne se pose pas au
# login HTTPS, ajouter le sous-réseau docker du compose (ex. 172.18.0.0/16).
#RESEAU_PROXIES_CONNUS=192.168.4.50

# --- Flux iCal public (Tailscale Funnel) ---
# Active le sidecar tailscale du compose (absent = pas d'exposition publique)
COMPOSE_PROFILES=funnel
# Auth key taguée (admin console Tailscale → Settings → Keys) ; la policy du
# tailnet doit accorder l'attribut « funnel » à ce tag
TS_AUTHKEY=
# Base de l'URL publique affichée dans « Mon calendrier »
ICAL_URL_PUBLIQUE_BASE=https://houseos.<tailnet>.ts.net

# --- Documents par courriel (Cloudflare Email Routing → Worker → R2) ---
# documents@alainnormandin.dev est routé vers le Worker houseos-courriel, qui dépose
# le courriel brut dans le bucket R2 ; l'app le relève toutes les 2 min. Facultatif :
# sans ces quatre valeurs, le relevé est désactivé (voir infra/courriel-worker/README.md).
# Endpoint S3 du compte : https://<ACCOUNT_ID>.r2.cloudflarestorage.com
COURRIEL_R2_ENDPOINT=
COURRIEL_R2_BUCKET=houseos-courriel
# Jeton R2 « Object Read & Write » scopé au bucket (R2 → Manage API Tokens)
COURRIEL_R2_CLE_ACCES=
COURRIEL_R2_CLE_SECRETE=
